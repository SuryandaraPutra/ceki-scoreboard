# ============================================================
# Ceki Scoreboard — Contoh Environment Variable
# Salin file ini ke .env.local dan sesuaikan nilainya
# ============================================================

# --- Database ---
# Lokal: biarkan kosong, otomatis pakai file SQLite ./data/ceki.db
# Vercel/Turso: isi dengan URL dan token dari Turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Keamanan PIN (opsional) ---
# Jika diisi, semua halaman meminta PIN sebelum bisa dipakai
# Jika kosong, aplikasi terbuka bebas (default untuk lokal)
APP_PIN=

# --- Secret untuk menandatangani cookie PIN ---
# Minimal 32 karakter acak; wajib diisi jika APP_PIN diisi
# Generate: openssl rand -base64 32
COOKIE_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# --- Konfigurasi Next.js ---
NEXT_PUBLIC_APP_NAME=Ceki Scoreboard
